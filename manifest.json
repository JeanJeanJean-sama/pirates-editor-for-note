{
  "manifest_version": 3,
  "name": "Pirates' Editor for note",
  "short_name": "Pen",
  "description": "自分のnoteの数値（PV・スキ・コメントなど）を毎日記録・分析する道具。推移、伸びた記事、未返信コメントを表示します。データはブラウザ内にだけ記録します。note公式のサービスではありません。",
  "version": "0.7.2",
  "homepage_url": "https://github.com/jeanjeanjean-sama/pirates-editor-for-note",
  "minimum_chrome_version": "116",
  "permissions": [
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://note.com/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://note.com/*"
      ],
      "js": [
        "src/perk-collect.js",
        "src/threads.js",
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Pirates' Editor for note を開く",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}